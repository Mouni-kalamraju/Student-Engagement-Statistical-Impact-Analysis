    <worksheet name='Engagement Decline: Paid vs. Free YOY'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Arial Black' fontsize='12'>Paid vs. Free YOY</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='minutes_watched_2021_paid_0_no_outliers.csv++ (Multiple Connections)' name='federated.09htex00pf6snl1dziphp1piztni' />
          </datasources>
          <datasource-dependencies datasource='federated.09htex00pf6snl1dziphp1piztni'>
            <column caption='Median Minutes Watched YOY Change' datatype='real' default-format='p0.00%' name='[Calculation_2026142487396411]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(MEDIAN([minutes_watched])) - LOOKUP(ZN(MEDIAN([minutes_watched])), -1)) / ABS(LOOKUP(ZN(MEDIAN([minutes_watched])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='directional signal' datatype='string' name='[Calculation_2026142522093628]' role='measure' type='nominal'>
