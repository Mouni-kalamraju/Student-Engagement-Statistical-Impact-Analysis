      <aliases enabled='yes' />
      <column caption='Lower_CI' datatype='real' name='[95% Confidence Interval]' role='measure' type='quantitative' />
      <column caption='CI Bar Length' datatype='real' name='[Calculation_1408216205324288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([F4]) - SUM([95% Confidence Interval])' />
      </column>
      <column caption='CI Upper Length' datatype='real' name='[Calculation_1450822365216768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[F4] - [Mean]' />
      </column>
      <column caption='T-Test Colour' datatype='string' name='[Calculation_1450822365458433]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [T-Test Conclusion] = &quot;Significant Increase&quot; THEN &quot;Green&quot;&#13;&#10;ELSEIF [T-Test Conclusion] = &quot;Significant Decrease&quot; THEN &quot;Red&quot;&#13;&#10;ELSE &quot;Gray&quot;&#13;&#10;END' />
        <aliases>
          <alias key='&quot;Green&quot;' value='Significant Increase' />
          <alias key='&quot;Red&quot;' value='Significant Decrease' />
        </aliases>
      </column>
      <column caption='Free Mean 2021' datatype='real' name='[Calculation_1450822372118530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : MAX(IF [Category] = &apos;2021_paid_0&apos; THEN [Mean] END)}' />
      </column>
      <column caption='Free Mean 2022' datatype='real' name='[Calculation_1450822373060611]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : MAX(IF [Category] = &apos;2022_paid_0&apos; THEN [Mean] END)}' />
      </column>
      <column caption='Free % Change' datatype='real' default-format='*+0.0%; -0.0%; 0.0%' name='[Calculation_1450822373171204]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1450822373060611] / [Calculation_1450822372118530]) - 1' />
      </column>
      <column caption='Paid Mean 2021' datatype='real' name='[Calculation_1450822373265413]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : MAX(IF [Category] = &apos;2021_paid_1&apos; THEN [Mean] END)}' />
      </column>
      <column caption='Paid Mean 2022' datatype='real' name='[Calculation_1450822373445638]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : MAX(IF [Category] = &apos;2022_paid_1&apos; THEN [Mean] END)}' />
      </column>
      <column caption='Paid % Change' datatype='real' default-format='*+0.0%; -0.0%; 0.0%' name='[Calculation_1450822373593095]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1450822373445638]  / [Calculation_1450822373265413]) - 1' />
      </column>
      <column caption='KPI - Free Engagement' datatype='string' name='[Calculation_1450822374195208]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;Free Mean Engagement: &quot; + STR(ROUND(ATTR([Calculation_1450822373171204]), 1)) + &quot;% (P &lt; 0.001)&quot;' />
      </column>
      <column caption='KPI - Paid Engagement' datatype='string' name='[Calculation_1450822374297609]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;Paid Mean Engagement: &quot; + STR(ROUND(ATTR([Calculation_1450822373593095]), 1)) + &quot;% (P &lt; 0.001)&quot;' />
      </column>
